  "methods": [
    {
      "name": "findItiAndTradeNamesByDistrictCode",
      "signature": "public abstract java.util.List<java.lang.Object[]> com.server.backend.Repository.ItiRepository.findItiAndTradeNamesByDistrictCode(java.lang.String)",
      "query": {
        "query": "SELECT i.iti_name, m.trade_name, t.strength FROM iti i LEFT JOIN ititrade t ON i.iti_code = t.iti_code LEFT JOIN ititrade_master m ON t.trade_short = m.trade_short WHERE i.dist_code = :distCode"
      }
    },
    {
      "name": "findItiAndTradeNamesByDistrictCodeAndGovt",
      "signature": "public abstract java.util.List<java.lang.Object[]> com.server.backend.Repository.ItiRepository.findItiAndTradeNamesByDistrictCodeAndGovt(java.lang.String,java.lang.String)",
      "query": {
        "query": "SELECT i.iti_name, m.trade_name, t.strength FROM iti i LEFT JOIN ititrade t ON i.iti_code = t.iti_code LEFT JOIN ititrade_master m ON t.trade_short = m.trade_short WHERE i.dist_code = :distCode AND i.govt = :govt"
      }
    },
